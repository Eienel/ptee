  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
